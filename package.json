{
  "name": "opbs",
  "version": "0.5.0",
  "description": "OPBS - Open Pickle Backup System: FOSS disk imaging backup for Windows",
  "author": "RHITCS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "npm run build:codec && npm run build:main && npm run build:preload && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:codec && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:native": "node-gyp rebuild",
    "start": "electron .",
    "test": "vitest",
    "lint": "eslint src",
    "package": "npm run build && electron-builder",
    "package:portable": "npm run build && electron-builder --win portable",
    "build:codec": "esbuild node_modules/zstdify/dist/index.js --bundle --format=cjs --platform=node --target=node18 --outfile=dist/zstdify.cjs --log-level=warning",
    "test:e2e": "vitest run test/integration"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "bonjour-service": "^1.4.4",
    "cron-parser": "^5.10.1",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fzstd": "^0.1.1",
    "node-cron": "^3.0.3",
    "ssh2": "^1.17.0",
    "zstdify": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "node-gyp": "^10.0.1",
    "playwright": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.0.4",
    "vitest": "^1.0.4"
  },
  "build": {
    "appId": "com.rhitcs.opbs",
    "productName": "OPBS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "src/native/build/Release/opbs_native.node"
    ],
    "asarUnpack": [
      "src/native/build/Release/opbs_native.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "fileAssociations": [
        {
          "ext": "opbs",
          "name": "OPBS Disk Image",
          "description": "OPBS Disk Image",
          "icon": "resources/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://opbs.rhitcs.com/updates"
    }
  }
}
