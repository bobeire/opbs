{
    "version": "0.6.113",
    "description": "Free and open-source disk imaging backup for Windows with Macrium image restore, differential chains and self-verifying repositories",
    "homepage": "https://github.com/bobeire/opbs",
    "license": "GPL-3.0-only",
    "notes": [
        "Read-only file mounts require WinFsp (https://winfsp.dev).",
        "Your backup configuration lives in %APPDATA%\\OPBS and is kept on uninstall."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/bobeire/opbs/releases/download/0.6.113/OPBS-Setup-0.6.113.exe#/dl.7z",
            "hash": "sha512:38577aa18a6ea976e5cc85abbdfb4512a16b56244823f0196b9b1127dc0aeb20bb48d8ff72f672298d80507b89e2cb9c6def1d2f801996e309a2fde185d128af",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal",
                "Remove-Item \"$dir\\`$*\" -Recurse"
            ]
        }
    },
    "bin": "OPBS.exe",
    "shortcuts": [
        [
            "OPBS.exe",
            "OPBS"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/bobeire/opbs/releases/download/$version/OPBS-Setup-$version.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
